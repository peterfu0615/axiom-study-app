{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subject",
    "problem_type",
    "stem_markdown",
    "choices",
    "sub_questions",
    "diagram",
    "knowledge_points",
    "knowledge_tags",
    "method_tags",
    "model_tags",
    "difficulty",
    "error_categories",
    "warnings"
  ],
  "properties": {
    "title": { "type": ["string", "null"] },
    "subject": { "type": ["string", "null"] },
    "problem_type": { "type": ["string", "null"] },
    "stem_markdown": { "type": ["string", "null"] },
    "choices": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sub_questions": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "content"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagram": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["exists", "kind", "bbox"],
      "properties": {
        "exists": { "type": "boolean" },
        "kind": {
          "type": ["string", "null"],
          "enum": ["geometry", "function", "chart", "table", "other", null]
        },
        "bbox": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "minimum": 0, "maximum": 1 },
            "height": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "knowledge_points": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge_tags": { "$ref": "#/$defs/tag_candidates" },
    "unresolved_knowledge_candidates": { "$ref": "#/$defs/tag_candidates" },
    "method_tags": { "$ref": "#/$defs/tag_candidates" },
    "model_tags": { "$ref": "#/$defs/tag_candidates" },
    "error_categories": { "$ref": "#/$defs/tag_candidates" },
    "textbook_hint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "grade", "volume", "publisher", "edition", "evidence"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "grade": { "type": ["string", "null"] },
        "volume": { "type": ["string", "null"] },
        "publisher": { "type": ["string", "null"] },
        "edition": { "type": ["string", "null"] },
        "evidence": { "type": "string" }
      }
    },
    "difficulty": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["level", "score", "reason"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["basic", "intermediate", "advanced"]
        },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    },
    "warnings": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "tag_candidates": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "evidence", "source"],
        "properties": {
          "canonical_tag_id": { "type": ["string", "null"], "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["primary", "secondary"] },
          "evidence": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["problem", "solution", "student_attempt", "textbook_hint"]
          }
        }
      }
    }
  }
}
